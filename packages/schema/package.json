{
  "name": "@obnixe/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": {
      "types": "./migrations/migrations.d.ts",
      "default": "./migrations/migrations.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "rm -rf migrations/meta migrations/*.sql && drizzle-kit generate --name init",
    "test": "vitest run",
    "catalog:snapshot": "node --experimental-strip-types scripts/update-catalog-snapshot.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
