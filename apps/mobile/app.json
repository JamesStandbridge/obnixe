{
  "expo": {
    "name": "Obnixe",
    "slug": "obnixe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jamesstandbridge.obnixe"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c1013",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jamesstandbridge.obnixe"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "scheme": "obnixe",
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c1013",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      "expo-notifications",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Obnixe importe tes photos de progression et les garde sur ce téléphone.",
          "cameraPermission": "Obnixe prend tes photos de progression et les garde sur ce téléphone.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
