{
  "expo": {
    "name": "Obnixe",
    "slug": "obnixe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jamesstandbridge.obnixe",
      "infoPlist": {
        "NSCameraUsageDescription": "Obnixe utilise la caméra pour lire le QR code d'appairage affiché par obnixe-bridge et pour prendre tes photos de progression, gardées sur ce téléphone.",
        "NSLocalNetworkUsageDescription": "Obnixe se connecte à obnixe-bridge sur ton ordinateur, via le Wi-Fi ou Tailscale, pour qu'un agent lise et note tes séances."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#e5ed32",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jamesstandbridge.obnixe"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "scheme": "obnixe",
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e5ed32",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      "expo-notifications",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Obnixe importe tes photos de progression et les garde sur ce téléphone.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7a12dadc-3e11-40c0-8871-6924532e6425"
      }
    },
    "owner": "jamesbiolevate"
  }
}
