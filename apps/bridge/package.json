    "test": "vitest run"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@obnixe/core": "workspace:*",
    "@obnixe/schema": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "obnixe-relay": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
