{
  "name": "obnixe-bridge",
  "version": "0.1.0",
  "description": "MCP server that lets Cursor or Codex read and log training data in the Obnixe phone app.",
  "license": "UNLICENSED",
  "author": "James Standbridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesStandbridge/obnixe.git",
    "directory": "apps/bridge"
  },
  "type": "module",
  "bin": {
    "obnixe-bridge": "./dist/main.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs",
